filters:
  and:
    - file.hasTag("dokument")
    - not:
        - file.inFolder("99_Vorlagen")
views:
  - type: table
    name: "Alle Dokumente"
    order:
      - note.datum
      - note.schueler
      - note.typ
      - note.status
      - note.cloud_link
  - type: table
    name: "Nach Schüler gruppiert"
    groupBy:
      property: note.schueler
      direction: ASC
    order:
      - note.datum
      - note.typ
      - note.status
