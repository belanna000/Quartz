filters:
  and:
    - file.hasTag("schueler")
    - not:
        - file.inFolder("99_Vorlagen")
views:
  - type: table
    name: "Alle Schüler"
    order:
      - note.nachname
      - note.vorname
      - note.klasse
      - note.status
      - note.besonderheiten
      - note.foerderbedarf
      - note.eltern_telefon
      - note.eltern_email
  - type: table
    name: "Mit Bemerkungen"
    filters:
      and:
        - note.besonderheiten == true
    order:
      - note.nachname
      - note.vorname
      - note.klasse
      - note.sitzplatz_hinweis
      - note.foerderbedarf
  - type: table
    name: "Förderbedarf"
    filters:
      and:
        - note.foerderbedarf != ""
    order:
      - note.foerderbedarf
      - note.nachname
      - note.vorname
      - note.klasse
  - type: cards
    name: "Karten"
    order:
      - note.vorname
      - note.nachname
      - note.klasse
      - note.foto
