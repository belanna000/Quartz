filters:
  and:
    - file.hasTag("fehlzeit")
    - not:
        - file.inFolder("99_Vorlagen")
views:
  - type: table
    name: "Alle Fehlzeiten"
    order:
      - note.datum_von
      - note.schueler
      - note.klasse
      - note.art
      - note.dauer_tage
      - note.versaeumnisanzeige_verschickt
  - type: table
    name: "Nach Schüler gruppiert"
    groupBy:
      property: note.schueler
      direction: ASC
    summaries:
      note.dauer_tage: Sum
    order:
      - note.datum_von
      - note.art
      - note.dauer_tage
  - type: table
    name: "Unentschuldigt - offen"
    filters:
      and:
        - 'note.art == "unentschuldigt"'
        - note.versaeumnisanzeige_verschickt == false
    order:
      - note.datum_von
      - note.schueler
      - note.klasse
